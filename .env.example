# Copie para .env e ajuste. Nunca versione o .env.

# Banco (docker-compose local)
DB_NAME=fittrack
DB_USERNAME=fittrack
DB_PASSWORD=troque-esta-senha
DB_PORT=5433

# Backend
DB_URL=jdbc:postgresql://localhost:5433/fittrack
JWT_SECRET=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres
JWT_EXPIRATION_HOURS=72
CORS_ALLOWED_ORIGINS=http://localhost:4200
FRONTEND_URL=http://localhost:4200
APP_TIMEZONE=America/Sao_Paulo
# true so em desenvolvimento: devolve o token de recuperacao de senha na resposta (sem SMTP)
EXPOSE_RESET_TOKEN=true
PORT=8080
